---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Daniel Kocot">
	<!-- Hero Section -->
	<section class="min-h-[20vh] bg-gradient-to-br from-[#2f3e46]/10 via-white to-[#4e5d6a]/10 -mx-4 px-4 mb-12 flex items-center justify-center py-12">
		<div class="text-center max-w-3xl">
			<h1 class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-[#2f3e46] to-[#4e5d6a] bg-clip-text text-transparent">
				Let's Connect
			</h1>
			<p class="text-xl text-gray-600">
				I'd love to hear from you about API architecture, speaking opportunities, or technical collaboration.
			</p>
		</div>
	</section>

	<!-- Contact Methods -->
	<section class="mb-16 not-prose">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
			<!-- Email -->
			<a href="mailto:daniel.kocot@adorsys.com" class="bg-[#f7f8f9] rounded-lg shadow-xl hover:shadow-2xl transition-all hover:scale-105 p-6 flex flex-col items-center text-center">
				<div class="text-[#2f3e46] text-5xl mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
					</svg>
				</div>
				<h3 class="text-2xl font-bold mb-2">Email</h3>
				<p class="text-gray-600 mb-2">Drop me a line</p>
			</a>

			<!-- LinkedIn -->
			<a href="https://www.linkedin.com/in/danielkocot" target="_blank" rel="noopener noreferrer" class="bg-[#f7f8f9] rounded-lg shadow-xl hover:shadow-2xl transition-all hover:scale-105 p-6 flex flex-col items-center text-center">
				<div class="text-[#2f3e46] text-5xl mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="currentColor" viewBox="0 0 24 24">
						<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
					</svg>
				</div>
				<h3 class="text-2xl font-bold mb-2">LinkedIn</h3>
				<p class="text-gray-600 mb-2">Connect professionally</p>
			</a>

			<!-- Bluesky -->
			<a href="https://bsky.app/profile/danielkocot.bsky.social" target="_blank" rel="noopener noreferrer" class="bg-[#f7f8f9] rounded-lg shadow-xl hover:shadow-2xl transition-all hover:scale-105 p-6 flex flex-col items-center text-center">
				<div class="text-[#2f3e46] text-5xl mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="currentColor" viewBox="0 0 568 501">
						<path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.21C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.333 453.32c-119.86 122.992-172.272-30.859-185.702-70.281-2.462-7.227-3.614-10.608-3.631-7.733-.017-2.875-1.169.506-3.631 7.733-13.43 39.422-65.842 193.273-185.702 70.281-63.111-64.76-33.89-129.52 80.986-149.071-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.659 0 75.291 0 57.946 0-28.906 76.135-1.612 123.121 33.664Z"/>
					</svg>
				</div>
				<h3 class="text-2xl font-bold mb-2">Bluesky</h3>
				<p class="text-gray-600 mb-2">Follow for API insights</p>
			</a>

			<!-- GitHub -->
			<a href="https://github.com/danielkocot" target="_blank" rel="noopener noreferrer" class="bg-[#f7f8f9] rounded-lg shadow-xl hover:shadow-2xl transition-all hover:scale-105 p-6 flex flex-col items-center text-center">
				<div class="text-[#2f3e46] text-5xl mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
				</div>
				<h3 class="text-2xl font-bold mb-2">GitHub</h3>
				<p class="text-gray-600 mb-2">Check out my code</p>
			</a>
		</div>
	</section>

	<!-- Additional Info -->
	<section class="mb-16 max-w-3xl mx-auto">
		<div class="bg-[#0b6bcb]/10 border-l-4 border-[#0b6bcb] rounded-lg p-6 flex gap-4">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6 text-[#0b6bcb]">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
			</svg>
			<div>
				<h3 class="font-bold mb-1">Looking to collaborate?</h3>
				<p class="text-sm text-gray-700">I'm always interested in speaking engagements, writing opportunities, and consulting projects related to API architecture and enterprise integration.</p>
			</div>
		</div>
	</section>

	<!-- Back to Home -->
	<section class="text-center mb-16">
		<a href="/" class="inline-flex items-center px-8 py-4 text-lg font-medium rounded-lg text-[#2f3e46] border-2 border-[#2f3e46] hover:bg-[#2f3e46] hover:text-white transition-colors">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
			</svg>
			Back to Home
		</a>
	</section>
</Layout>
