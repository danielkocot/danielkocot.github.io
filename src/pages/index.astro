	<!-- CTA Section -->
	<section class="text-center py-16 bg-[#f7f8f9] rounded-lg border border-gray-200 -mx-4 px-4 not-prose">
		<h2 class="text-3xl font-bold mb-4 text-[#2f3e46]">Let's Connect</h2>
		<p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
			Interested in API architecture, speaking opportunities, or technical collaboration? 
			I'd love to hear from you.
		</p>
		<a href="/contact" class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-white bg-[#2f3e46] hover:bg-[#4e5d6a] transition-colors">
			Get in Touch
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
			</svg>
		</a>
	</section>
</Layout>
