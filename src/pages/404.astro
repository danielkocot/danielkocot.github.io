---
import Layout from "../layouts/Layout.astro"
---

<Layout title="404 - Not Found">
    <section class="text-center py-20">
        <h2 class="text-6xl font-bold text-[#2f3e46] mb-4">404</h2>
        <p class="text-xl text-gray-600 mb-8">This page does not exist.</p>
        <a href="/" class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-white bg-[#2f3e46] hover:bg-[#4e5d6a] transition-colors">Back to Home</a>
    </section>
</Layout>