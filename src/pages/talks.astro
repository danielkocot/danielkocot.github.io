---
import Layout from '../layouts/Layout.astro';
import talksData from '../data/talks.json';

const currentDate = new Date();

const allTalks = talksData.talks.map(talk => ({
	...talk,
}));

const upcomingTalks = allTalks
	.filter(talk => talk.date && new Date(talk.date) > currentDate)
	.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const talks = allTalks
	.filter(talk => !talk.date || new Date(talk.date) <= currentDate)
	.sort((a, b) => {
		if (!a.date) return 1;
		if (!b.date) return -1;
		return new Date(b.date).getTime() - new Date(a.date).getTime();
	});
---

<Layout title="Talks & Speaking | Daniel Kocot">
	<!-- Hero Section -->
	<section class="min-h-[20vh] bg-white border-b border-gray-200 -mx-4 px-4 mb-12 flex items-center justify-center py-12">
		<div class="text-center max-w-3xl">
			<h1 class="text-4xl md:text-5xl font-bold mb-4 text-[#2f3e46]">
				Talks & Speaking
			</h1>
			<p class="text-xl text-gray-600">
				Sharing insights on API architecture, event-driven systems, and software engineering at conferences and meetups
			</p>
		</div>
	</section>

	<!-- Stats Section -->
	<section class="mb-16 not-prose">
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full">
			<div class="bg-[#f7f8f9] rounded-lg shadow-lg p-6 text-center">
				<div class="flex justify-center mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-8 h-8 stroke-current text-[#2f3e46]">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
					</svg>
				</div>
				<div class="text-sm font-medium text-gray-600 mb-2">Talks Given</div>
				<div class="text-4xl font-bold text-[#2f3e46] mb-2">{talks.length}+</div>
				<div class="text-sm text-gray-500">Conferences & Meetups</div>
			</div>
			
			<div class="bg-[#f7f8f9] rounded-lg shadow-lg p-6 text-center">
				<div class="flex justify-center mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-8 h-8 stroke-current text-[#4e5d6a]">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
					</svg>
				</div>
				<div class="text-sm font-medium text-gray-600 mb-2">Attendees Reached</div>
				<div class="text-4xl font-bold text-[#4e5d6a] mb-2">500+</div>
				<div class="text-sm text-gray-500">Across all events</div>
			</div>
			
			<div class="bg-[#f7f8f9] rounded-lg shadow-lg p-6 text-center">
				<div class="text-sm font-medium text-gray-600 mb-2">Countries</div>
				<div class="text-4xl font-bold text-[#0b6bcb] mb-2">5+</div>
				<div class="text-sm text-gray-500">International speaking</div>
			</div>
		</div>
	</section>

	<!-- Upcoming Talks -->
	{upcomingTalks.length > 0 ? (
		<section class="mb-16 not-prose">
		<h2 class="text-3xl font-bold mb-8 flex items-center gap-3">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
			</svg>
			Upcoming Talks
		</h2>
		<div class="grid grid-cols-1 gap-6">
			{upcomingTalks.map(talk => (
				<article class="bg-gradient-to-r from-[#2f3e46]/5 to-[#4e5d6a]/5 border-2 border-[#2f3e46]/20 rounded-lg shadow-xl hover:shadow-2xl transition-shadow p-6">
					<div class="flex items-start justify-between gap-4">
						<div class="flex-1">
							<div class="inline-flex items-center px-4 py-2 rounded-full text-base font-medium bg-[#2f3e46] text-white mb-3">{talk.type}</div>
							<h3 class="text-2xl font-bold mb-2">{talk.title}</h3>
							<div class="flex flex-wrap gap-3 mb-3 text-sm text-gray-600">
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
										</svg>
										{talk.event}
									</span>
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
										</svg>
										{talk.date}
									</span>
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
										</svg>
										{talk.location}
									</span>
									{talk.cospeaker && (
										<span class="flex items-center gap-1">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
											</svg>
											Co-speaker: {talk.cospeaker}
										</span>
									)}
							</div>
							<p class="text-gray-700 mb-4">{talk.description}</p>
							<div class="flex flex-wrap gap-2">
								{talk.topics.map(topic => (
									<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium text-[#2f3e46] border border-[#2f3e46]">{topic}</span>
								))}
							</div>
						</div>
					</div>
					{talk.registration && (
						<div class="flex justify-end mt-4">
							<a href={talk.registration} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-white bg-[#2f3e46] hover:bg-[#4e5d6a] transition-colors">
								Register Now
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
								</svg>
							</a>
						</div>
					)}
				</article>
			))}
		</div>
		</section>
	) : null}


	<!-- Past Talks -->
	<section class="mb-16 not-prose">
		<h2 class="text-3xl font-bold mb-8 flex items-center gap-3">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
			</svg>
			Past Talks
		</h2>
		<div class="grid grid-cols-1 gap-6">
			{talks.map(talk => (
				<article class="bg-[#f7f8f9] hover:bg-[#ecedef] transition-colors shadow-md rounded-lg p-6">
					<div class="flex items-start justify-between gap-4 flex-wrap">
						<div class="flex-1 min-w-0">
							<div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white text-gray-700 mb-3">{talk.type}</div>
							<h3 class="text-xl font-bold mb-2">{talk.title}</h3>
							<div class="flex flex-wrap gap-3 mb-3 text-sm text-gray-600">
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
										</svg>
										{talk.event}
									</span>
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
										</svg>
										{talk.date}
									</span>
									<span class="flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
										</svg>
										{talk.location}
									</span>
									{talk.cospeaker && (
										<span class="flex items-center gap-1">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
											</svg>
											Co-speaker: {talk.cospeaker}
										</span>
									)}
							</div>
							<p class="text-gray-700 mb-4">{talk.description}</p>
							<div class="flex flex-wrap gap-2">
								{talk.topics.map(topic => (
									<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium text-[#2f3e46] border border-[#2f3e46]">{topic}</span>
								))}
						</div>
					</div>
					<div class="flex gap-2 shrink-0 not-prose">
					{talk.slides && (
						<a href={talk.slides} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg !text-[#2f3e46] !bg-white !border-2 !border-[#2f3e46] hover:!bg-[#2f3e46] hover:!text-white transition-colors !no-underline" title="View Slides">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
								</svg>
								Slides
							</a>
						)}
				{talk.video && (
					<a href={talk.video} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg !text-[#2f3e46] !bg-white !border-2 !border-[#2f3e46] hover:!bg-[#2f3e46] hover:!text-white transition-colors !no-underline" title="Watch Video">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
								Video
							</a>
						)}
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- Speaking Topics -->
	<section class="mb-16 not-prose">
		<h2 class="text-3xl font-bold text-center mb-8">Speaking Topics</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			<div class="bg-[#2f3e46] text-white shadow-lg rounded-lg p-6">
				<h3 class="text-xl font-bold mb-3 flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					API Architecture
				</h3>
				<p class="opacity-90">REST, GraphQL, gRPC, AsyncAPI, API-first design, versioning strategies, and developer experience</p>
			</div>

			<div class="bg-[#4e5d6a] text-white shadow-lg rounded-lg p-6">
				<h3 class="text-xl font-bold mb-3 flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
					</svg>
					Event-Driven Systems
				</h3>
				<p class="opacity-90">Kafka, event sourcing, CQRS, messaging patterns, and building resilient distributed systems</p>
			</div>

			<div class="bg-[#0b6bcb] text-white shadow-lg rounded-lg p-6">
				<h3 class="text-xl font-bold mb-3 flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
					</svg>
					Standards & Best Practices
				</h3>
				<p class="opacity-90">OpenAPI, JSON Schema, OpenTelemetry, and navigating the complex landscape of software standards</p>
			</div>

			<div class="bg-[#2f3e46] text-white shadow-lg rounded-lg p-6">
				<h3 class="text-xl font-bold mb-3 flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
					</svg>
					Microservices Architecture
				</h3>
				<p class="opacity-90">Service design, domain-driven design, API gateways, service mesh, and distributed systems patterns</p>
			</div>

			<div class="bg-[#4e5d6a] text-white shadow-lg rounded-lg p-6">
				<h3 class="text-xl font-bold mb-3 flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
					</svg>
					Developer Experience
				</h3>
				<p class="opacity-90">Building developer-friendly APIs, documentation strategies, SDK design, and API platform engineering</p>
			</div>

			<div class="bg-[#0b6bcb] text-white shadow-lg rounded-lg p-6">
				<h3 class="text-xl font-bold mb-3 flex items-center">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
					</svg>
					Platform Engineering
				</h3>
				<p class="opacity-90">Building internal developer platforms, API management, observability, and enabling engineering teams</p>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="text-center py-16 bg-gradient-to-r from-[#2f3e46]/10 to-[#4e5d6a]/10 rounded-lg -mx-4 px-4 not-prose">
		<h2 class="text-3xl font-bold mb-4">Invite Me to Speak</h2>
		<p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
			Looking for a speaker for your conference, meetup, or corporate event? 
			I'd love to share insights with your audience.
		</p>
		<a href="/contact" class="inline-flex items-center px-8 py-4 text-lg font-medium rounded-lg text-white bg-[#2f3e46] hover:bg-[#4e5d6a] transition-colors">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
			</svg>
			Get in Touch
		</a>
	</section>
</Layout>
