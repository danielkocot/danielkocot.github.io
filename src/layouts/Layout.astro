---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
const { title = "Daniel Kocot", description = "Principal API Consultant | Speaker | Author of Architectural Bytes"} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content="{description}" />
	</head>
	<body class="bg-base-100 text-base-content">
		<header class="navbar bg-base-200 shadow-sm mb-8">
			<div class="flex-1">
				<a href="/" class="btn btn-ghost text-xl text-primary normal-case">Daniel Kocot</a>
			</div>
			<nav class="flex-none gap-2 mr-4">
				<a href="/" class="btn btn-ghost btn-sm">Home</a>
				<a href="/about" class="btn btn-ghost btn-sm">About</a>
				<a href="/talks" class="btn btn-ghost btn-sm">Talks</a>
				<a href="/contact" class="btn btn-ghost btn-sm">Contact</a>
			</nav>
			<!-- <ThemeToggle /> -->
		</header>
		<main class="prose lg:prose-lg mx-auto px-4">
			<slot />
		</main>
		<footer class="footer footer-center p-4 bg-base-200 text-base-content mt-12">
			<p>&copy; 2016 - {new Date().getFullYear()} Daniel Kocot - Built with <a href="https://astro.build">Astro</a></p>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
